# ==============================================================================
# Zaalima High-Concurrency Agent Orchestrator - Deployment Configuration
# Copy this file to .env before starting the deployment:
#   cp .env.example .env
# ==============================================================================

# Primary Orchestrator Node Ports
HTTP_PORT=8080
GRPC_PORT=9090

# Secondary Orchestrator Node Ports (for --profile multi-node)
HTTP_PORT_NODE2=8081
GRPC_PORT_NODE2=9091

# Node Identification
NODE_ID_PRIMARY=node-1
NODE_ID_SECONDARY=node-2
NODE_LOAD_TTL_SECONDS=15

# Redis Service Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PORT_HOST=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# JVM Resource Settings (compatible with container memory constraints)
JAVA_TOOL_OPTIONS=--enable-preview -XX:+UseG1GC -XX:MaxRAMPercentage=75.0


# Distributed Locking Strategy (redis for cluster multi-node / in-memory for standalone dev)
LOCK_TYPE=redis
